generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String            @id @default(cuid())
  email               String            @unique
  username            String            @unique
  displayName         String?
  passwordHash        String
  avatarUrl           String?
  bio                 String?
  favoriteGenres      String[]
  publicProfile       Boolean           @default(true)
  socialTwitter       String?
  socialAnilist       String?
  socialMal           String?
  stripeCustomerId    String?
  subscriptionStatus  String            @default("free")
  subscriptionEndDate DateTime?
  createdAt           DateTime          @default(now())

  bookmarks           Bookmark[]
  readingList         ReadingListItem[]
  readingProgress     ReadingProgress[]
  downloads           Download[]
  ratings             Rating[]
  comments            Comment[]

  @@index([email])
  @@index([username])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  mangaId    String
  chapterId  String
  pageNumber Int
  note       String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mangaId])
}

model ReadingListItem {
  id            String   @id @default(cuid())
  userId        String
  mangaId       String
  mangaTitle    String
  coverUrl      String?
  status        String
  chaptersRead  Int      @default(0)
  totalChapters Int?
  addedAt       DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mangaId])
  @@index([userId])
}

model ReadingProgress {
  id         String   @id @default(cuid())
  userId     String
  mangaId    String
  chapterId  String
  pageNumber Int
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId])
  @@index([mangaId])
}

model Download {
  id         String   @id @default(cuid())
  userId     String
  chapterId  String
  mangaId    String
  chapterNum String
  mangaTitle String
  status     String
  filePath   String?
  fileSize   Int?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mangaId])
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  mangaId   String
  score     Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mangaId])
  @@index([mangaId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  mangaId   String
  content   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mangaId])
  @@index([userId])
}

model CachedManga {
  mangaDexId String   @id
  data       Json
  cachedAt   DateTime @default(now())
}
