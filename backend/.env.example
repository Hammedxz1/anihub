NODE_ENV=development
PORT=3001

# PostgreSQL — replace with your actual connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mangaverse?schema=public"

# Secrets — generate with: openssl rand -base64 48
JWT_SECRET=replace_with_at_least_32_char_secret_here
JWT_REFRESH_SECRET=replace_with_different_at_least_32_char_secret

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=12
